# ─────────────────────────────────────────────────────────────────────────────
# Money Right — Environment Configuration
# Copy this file to .env and fill in your values.
# Lines starting with # are comments and are ignored.
# Never commit your .env file to Git — it contains secrets.
# ─────────────────────────────────────────────────────────────────────────────


# ── APPLICATION ───────────────────────────────────────────────────────────────

# Flask session signing key — REQUIRED in production.
# Generate a secure random string: python -c "import secrets; print(secrets.token_hex(32))"
# Leave blank when running locally with FLASK_ENV=development (auto-generates unsafe key).
SECRET_KEY=

# Set to 'development' to enable Flask debug mode and auto-reload.
# Remove or set to 'production' before distributing or deploying.
FLASK_ENV=development

# Optional password gate for the entire app.
# If set, users must enter this password to access the app.
# Leave blank for open local access (recommended for personal use on trusted network).
APP_PASSWORD=


# ── MARKET DATA ───────────────────────────────────────────────────────────────

# CoinGecko API key — RECOMMENDED (free Demo tier works).
# Without this, CoinGecko rate-limits you to ~30 requests/minute.
# Get a free key at: https://www.coingecko.com/en/api/pricing
# Click "Get Started" under the Demo plan — no credit card required.
COINGECKO_API_KEY=


# ── KRAKEN (Crypto Exchange) ──────────────────────────────────────────────────

# Kraken API credentials for trade history sync and balance monitoring.
# Get these at: https://www.kraken.com/u/security/api
# Create a key with ONLY these permissions: Query Funds, Query Closed Orders & Trades
# Do NOT enable trading permissions for a read-only integration.
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# How often to sync Kraken trade history (in minutes). Default: 5.
KRAKEN_SYNC_INTERVAL_MINUTES=5


# ── COINBASE (Crypto Exchange — Optional) ─────────────────────────────────────

# Coinbase Advanced Trade API — read-only.
# Get these at: https://cdp.coinbase.com → API Keys → Create API Key
# Select "View" permissions only. Download the JSON file when prompted.
# COINBASE_API_KEY_NAME is the "name" field from the downloaded JSON.
# COINBASE_API_PRIVATE_KEY is the "privateKey" field (EC private key, ECDSA algorithm).
# Leave blank if you don't use Coinbase.
COINBASE_API_KEY_NAME=
COINBASE_API_PRIVATE_KEY=

COINBASE_SYNC_INTERVAL_MINUTES=5


# ── KALSHI (Prediction Markets) ───────────────────────────────────────────────

# Kalshi API credentials for prediction market position tracking and order placement.
# Get these at: https://kalshi.com → Settings → API → Create API Key
# Download the key file — it contains both the Key ID and RSA Private Key.
# KALSHI_API_KEY_ID is the UUID key identifier.
# KALSHI_API_PRIVATE_KEY is the RSA private key PEM — paste with real newlines
#   inside double quotes in this file:
#   KALSHI_API_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----
#   MIIEow...
#   -----END RSA PRIVATE KEY-----"
# Leave blank if you don't use Kalshi.
KALSHI_API_KEY_ID=
KALSHI_API_PRIVATE_KEY=

# Set to 'true' to use Kalshi's demo sandbox (demo.kalshi.co) instead of production.
# Use this for testing order placement without risking real money.
# Requires a separate demo account at demo.kalshi.co with its own API keys.
KALSHI_DEMO_MODE=false

KALSHI_SYNC_INTERVAL_MINUTES=5


# ── GMAIL (Bank & Credit Email Parsing) ───────────────────────────────────────

# Gmail credentials for automatic transaction parsing from bank/credit card emails.
# IMPORTANT: Use an App Password, NOT your regular Gmail password.
#
# Setup steps:
#   1. Enable 2-Factor Authentication on your Google account (required for App Passwords)
#   2. Go to: https://myaccount.google.com/apppasswords
#   3. Select app: "Mail" → Generate
#   4. Copy the 16-character password shown (spaces don't matter)
#
# SECURITY TIP: Consider using a dedicated Gmail account just for financial emails
# rather than your main personal account. Forward bank/credit alerts to it.
#
# Leave blank to disable email parsing.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# How often to check for new financial emails (in minutes). Default: 15.
EMAIL_SYNC_INTERVAL_MINUTES=15


# ── NOTIFICATIONS ─────────────────────────────────────────────────────────────

# Telegram bot for push notifications on all devices including iOS.
# Setup:
#   1. Open Telegram → message @BotFather → send /newbot → follow prompts
#   2. Copy the bot token shown after creation
#   3. Start a chat with your new bot (send it any message)
#   4. Visit: https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates
#   5. Find "id" inside the "chat" object — that's your Chat ID
# Leave blank to disable Telegram notifications.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ntfy.sh push notifications — works on Android and iOS via the ntfy app.
# Choose a unique topic name (like a password — anyone who knows it can subscribe).
# Setup:
#   1. Install the ntfy app on your phone
#   2. Subscribe to your chosen topic name
#   3. Set the same topic name here
# Leave blank to disable ntfy notifications.
NTFY_TOPIC=

# Web Push (VAPID) — enables push notifications when the app is installed as a PWA.
# Generate keys by running: python generate_vapid.py
# Or manually: pip install py-vapid && python -c "
#   from py_vapid import Vapid; from cryptography.hazmat.primitives.serialization import Encoding, PublicFormat
#   import base64; v = Vapid(); v.generate_keys()
#   print('VAPID_PRIVATE_KEY=' + base64.urlsafe_b64encode(v.private_key.private_bytes_raw()).decode().rstrip('='))
#   print('VAPID_PUBLIC_KEY=' + base64.urlsafe_b64encode(v.public_key.public_bytes(Encoding.X962, PublicFormat.UncompressedPoint)).decode().rstrip('='))
# "
# After generating, also add VAPID_PUBLIC_KEY to frontend/index.html:
#   <script>window.FINHUB_VAPID_PUBLIC_KEY = 'YOUR_PUBLIC_KEY';</script>
# Leave blank to disable Web Push notifications (Telegram/ntfy work without it).
FINHUB_VAPID_PRIVATE_KEY=
FINHUB_VAPID_PUBLIC_KEY=
VAPID_EMAIL=mailto:admin@moneyright.loca